# Copy to /etc/family-budget-backup.env (mode 600). Off-site copy for deploy/backup-run.sh:
# each archive is encrypted again with age to this public key (ssh-ed25519 or age1...) and uploaded with rclone.
# Leave BACKUP_REMOTE empty to keep backups local only.
BACKUP_REMOTE=gdrive:Backups/family-budget
BACKUP_AGE_RECIPIENT="ssh-ed25519 AAAA... you@host"
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
