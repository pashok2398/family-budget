# Nightly backup of what cannot be recreated: the ledger DB, original statements and receipts. Bank logins,
# fetcher state and the inbox are left out on purpose: logging in again restores them. Each archive is
# encrypted with age to the owner's public key (only their private key opens it), kept in <data dir>/backups
# and, with BACKUP_REMOTE set, copied off-site with rclone. Settings: /etc/family-budget-backup.env
# (see family-budget-backup.env.example).
[Unit]
Description=Family budget encrypted backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=__REPO__
Environment=KEEP_DAYS=30
EnvironmentFile=/etc/family-budget-backup.env
ExecStart=__REPO__/deploy/backup-run.sh
