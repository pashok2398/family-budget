# Runtime data must be outside the repository. Docker's UID 10001 needs write access.
FAMILY_BUDGET_HOST_DATA=/srv/family-budget
# LAN access (no authentication: anyone on the network gets full access). Leave unset for loopback only.
# FAMILY_BUDGET_BIND=192.168.1.10
# FAMILY_BUDGET_ALLOWED_HOSTS=192.168.1.10
